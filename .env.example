# Credenciales opcionales para el pipeline (en GitHub se cargan como Secrets).
# Banco Central de Chile – BDE. Recomendado: API Key Token (BDE → Mi Cuenta → "Apikey Token").
BCCH_TOKEN=
# Alternativa antigua: correo y contraseña de la cuenta BDE (solo si no usas token).
BCCH_USER=
BCCH_PASS=
# CMF Chile – API key gratuita (api.cmfchile.cl)
CMF_API_KEY=
