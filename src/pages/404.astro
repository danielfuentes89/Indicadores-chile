---
import Base from '../layouts/Base.astro';
---

<Base lang="es" title="404">
  <h1>Página no encontrada</h1>
  <p class="lead">La página que buscas no existe. / The page you are looking for does not exist.</p>
  <p><a href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}es/`}>Volver al inicio</a> · <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}en/`}>Back to home</a></p>
</Base>
