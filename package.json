{
  "name": "indicadores-chile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Indicadores de Chile actualizados desde fuentes oficiales, con dashboard personalizable.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
    "fetch": "node --env-file-if-exists=.env --import tsx pipeline/run.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/preact": "4.1.3",
    "astro": "5.18.2",
    "echarts": "6.0.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  }
}
